                "id": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source_class",
            "source_id"
          ],
          "additionalProperties": false
        },
        "label": {
          "type": "object",
          "properties": {
            "integrity": {
              "enum": [
                "trusted",
                "untrusted"
              ]
            },
            "sensitivity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "tenant_binding": {
              "enum": [
                "known",
                "mixed",
                "unknown"
              ]
            },
            "tenant_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "origins": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "integrity",
            "sensitivity",
            "tenant_binding",
            "tenant_ids",
            "origins"
          ],
          "additionalProperties": false
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
