{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paca:contracts:v1.0.0:paca-contracts",
  "title": "PACA++ Protocol Contracts v1.0.0",
  "description": "Platform-neutral message contracts. Authentication, canonicalisation and cross-field semantic checks are additionally mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/identity_context"
    },
    {
      "$ref": "#/$defs/provenance_evidence"
    },
    {
      "$ref": "#/$defs/policy_request"
    },
    {
      "$ref": "#/$defs/policy_response"
    },
    {
      "$ref": "#/$defs/authorization_grant"
    },
    {
      "$ref": "#/$defs/pep_invocation"
    },
    {
      "$ref": "#/$defs/commit_permit"
    },
    {
      "$ref": "#/$defs/broker_operation"
    },
    {
      "$ref": "#/$defs/isolation_profile"
    },
    {
      "$ref": "#/$defs/audit_event"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 40,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "signature"
      ],
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "service",
            "workload",
            "provider"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "resource_type": {
          "$ref": "#/$defs/id"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "provider": {
          "$ref": "#/$defs/id"
        },
        "version_id": {
          "$ref": "#/$defs/id"
        },
        "precondition_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "evidence_id",
        "digest"
      ],
      "additionalProperties": false
    },
    "provenance_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "version_id": {
          "$ref": "#/$defs/id"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "object_id",
        "version_id",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "resource_predicate": {
      "type": "object",
      "properties": {
        "predicate_type": {
          "$ref": "#/$defs/id"
        },
        "operator": {
          "enum": [
            "equals",
            "in",
            "prefix",
            "path-beneath",
            "uri-origin",
            "provider-object",
            "custom"
          ]
        },
        "value": {
          "type": [
            "string",
            "array",
            "object"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "predicate_type",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/id"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "identity_context": {
      "type": "object",
      "properties": {
        "message_id": {
          "$ref": "#/$defs/id"
        },
        "message_type": {
          "const": "paca.identity-context.v1"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/id"
        },
        "audience": {
          "$ref": "#/$defs/id"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        },
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "human",
                "agent",
                "service",
                "workload",
                "provider"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "workload": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "human",
                "agent",
                "service",
                "workload",
                "provider"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "tenant_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "oidc",
                "workload_identity",
                "mutual_tls",
                "platform_attestation",
                "other"
              ]
            },
            "issuer": {
              "type": "string",
              "format": "uri"
            },
            "subject_id": {
              "$ref": "#/$defs/id"
            },
            "credential_digest": {
              "$ref": "#/$defs/digest"
            },
            "authenticated_at": {
              "$ref": "#/$defs/timestamp"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "method",
            "issuer",
            "subject_id",
            "credential_digest",
            "authenticated_at",
            "expires_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_id",
        "message_type",
        "contract_version",
        "created_at",
        "issuer",
        "audience",
        "proof",
        "subject",
        "workload",
        "tenant_id",
        "task_id",
        "purpose",
        "session_id",
        "authentication"
      ],
      "additionalProperties": false
    },
