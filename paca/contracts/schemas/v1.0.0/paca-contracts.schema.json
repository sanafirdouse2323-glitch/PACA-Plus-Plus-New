        },
        "contract_version": {
          "const": "1.0.0"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/id"
        },
        "audience": {
          "$ref": "#/$defs/id"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        },
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "version_id": {
          "$ref": "#/$defs/id"
        },
        "content_digest": {
